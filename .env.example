# AIson frontend environment (Vite).
# Copy this file to `.env` and fill in the values. Every VITE_* variable is
# embedded into the browser bundle at build time, so NEVER put server secrets
# here — backend secrets (service role key, provider API keys, SMTP, etc.) live
# in Supabase Edge Function secrets, not in this file.

# Your Supabase project URL and ref
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Supabase publishable / anon key (public by design — safe in the client)
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-publishable-key>

# Optional: Varg video engine key (used by the browser-side video client)
VITE_VARG_API_KEY=<optional-varg-video-api-key>
